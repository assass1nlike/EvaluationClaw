{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationClaw Multimodal Item Spec",
  "type": "object",
  "required": ["schema_version", "modalities", "assets"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "evalclaw.multimodal.v1"
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["image", "audio", "video", "text"]
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["image", "audio", "video", "text"]
          },
          "uri": { "type": "string" },
          "path": { "type": "string" },
          "data_uri": { "type": "string" },
          "mime_type": { "type": "string" },
          "caption": { "type": "string" },
          "alt_text": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "text" },
              "text": { "type": "string" }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": ["type", "asset_id"],
            "properties": {
              "type": { "const": "asset" },
              "asset_id": { "type": "string" },
              "detail": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
