#!/bin/sh
qemu_root="/data1/zangyihe/EvaluationClaw/baselines/gym-anything/local/runtime/qemu/rootfs"
export QEMU_MODULE_DIR="$qemu_root/usr/lib/x86_64-linux-gnu/qemu"
exec "$qemu_root/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2" --library-path "$qemu_root/lib/x86_64-linux-gnu:$qemu_root/usr/lib/x86_64-linux-gnu" "$qemu_root/usr/bin/qemu-system-x86_64" -L "$qemu_root/usr/share/qemu" "$@"
