# EvalClaw environment variables. Copy to `.env` and fill in the keys you use.
# You only need the keys for the providers/backends you actually run.

# --- Anthropic (Claude models: default orchestrator & anthropic targets) ---
ANTHROPIC_API_KEY=

# --- OpenAI (gpt-*, o1/o3/o4 models) ---
OPENAI_API_KEY=

# --- DeepSeek (deepseek-* models, OpenAI-compatible) ---
DEEPSEEK_API_KEY=

# --- Google Gemini (gemini-* models + Gemini Google-Search grounding backend) ---
# Also enables the "gemini" search backend. Without it, search falls back to
# the keyless backend (arXiv + Wikipedia + DuckDuckGo).
GEMINI_API_KEY=

# --- Azure OpenAI (use model names like `azure/<deployment-name>`) ---
AZURE_API_KEY=            # API key for your Azure OpenAI resource (alias: AZURE_OPENAI_API_KEY)
AZURE_API_BASE=          # e.g. https://<your-resource>.openai.azure.com
AZURE_API_VERSION=       # e.g. 2024-06-01

# --- Reasoning models (gpt-5*, o1/o3/o4, deepseek-reasoner) ---
# Optional effort hint passed through to the provider (e.g. minimal/low/medium/high).
# Lower effort cuts latency and cost substantially; leave empty for provider default.
EVALCLAW_REASONING_EFFORT=
