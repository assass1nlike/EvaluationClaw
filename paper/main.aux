\newlabel{sec:design}{{3}{2}{EvalClaw Design}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  \textsc  {EvalClaw} pipeline overview. The \textbf  {Research-assisted Planner} grounds item plans in adaptively retrieved external resources. The \textbf  {EvalClaw-Harness} decomposes each plan into parallel construction threads, each with dedicated tool support, and enforces a Quality Check gate before producing a TaskDefinition. The \textbf  {Hypothesis-driven Analyzer} examines model evaluation results, forms a capability hypothesis, and invokes the full construction pipeline to generate targeted verification items; the loop terminates when the hypothesis is confirmed or revised. }}{3}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{3}{\textsc {EvalClaw} pipeline overview. The \textbf {Research-assisted Planner} grounds item plans in adaptively retrieved external resources. The \textbf {EvalClaw-Harness} decomposes each plan into parallel construction threads, each with dedicated tool support, and enforces a Quality Check gate before producing a TaskDefinition. The \textbf {Hypothesis-driven Analyzer} examines model evaluation results, forms a capability hypothesis, and invokes the full construction pipeline to generate targeted verification items; the loop terminates when the hypothesis is confirmed or revised}{figure.1}{}}
